act.get(\\\"turn_deg\\\", 0.0)\\n    move = act.get(\\\"move_m\\\", 0.0)\\n    heading = (heading + turn) % 360.0\\n    rad = math.radians(heading)\\n    x += move * math.sin(rad)\\n    y += move * math.cos(rad)\\n\\nprint(f\\\"Pose 60: x={x:.3f}, y={y:.3f}, heading={heading:.1f}\\\")\\n\\nH = 1.55\\nf = 256.0\\ncx0, cy0 = 255.5, 255.5\\n\\n# Chair in 60: cx = 236.0 (center of back/legs is around col 236), bottom = 397 (legs bottom)\\n# Let us check bottom of chair legs in 60\\nfrom PIL import Image\\nimport numpy as np\\nimg = np.array(Image.open(\\\"/work/observations/obs_0060.png\\\"))\\nmask_c = (img[:, :, 0] > 100) & (img[:, :, 0] < 180) & (img[:, :, 1] > 50) & (img[:, :, 1] < 120) & (img[:, :, 2] < 50) & (np.arange(512)[None, :] < 300)\\nyc, xc = np.where(mask_c)\\nprint(f\\\"Chair back & legs: xs=[{xc.min()}, {xc.max()}], ys=[{yc.min()}, {yc.max()}], bottom={yc.max()}, cx={xc.mean():.1f}\\\")\\n\\n# Distance to chair:\\nD_c = f * H / (yc.max() - cy0)\\nrad = math.radians(heading)\\ndx_cam = (xc.mean() - cx0) / f\\ngx_c = x + D_c * math.sin(rad) + D_c * dx_cam * math.cos(rad)\\ngy_c = y + D_c * math.cos(rad) - D_c * dx_cam * math.sin(rad)\\nprint(f\\\"Chair from 60: D={D_c:.3f}m -> ({gx_c:.3f}, {gy_c:.3f})\\\")\\n\\n# Lamp base from 60:\\nD_l = f * H / (423 - cy0)\\ndx_cam_l = (450.1 - cx0) / f\\ngx_l = x + D_l * math.sin(rad) + D_l * dx_cam_l * math.cos(rad)\\ngy_l = y + D_l * math.cos(rad) - D_l * dx_cam_l * math.sin(rad)\\nprint(f\\\"Lamp base from 60: D={D_l:.3f}m -> ({gx_l:.3f}, {gy_l:.3f})\\\")\\n\\n# Jug from 60:\\nD_j = f * H / (398 - cy0)\\ndx_cam_j = (43.2 - cx0) / f\\ngx_j = x + D_j * math.sin(rad) + D_j * dx_cam_j * math.cos(rad)\\ngy_j = y + D_j * math.cos(rad) - D_j * dx_cam_j * math.sin(rad)\\nprint(f\\\"Jug from 60: D={D_j:.3f}m -> ({gx_j:.3f}, {gy_j:.3f})\\\")\\n'\", \"description\": \"Compute exact positions for chair, lamp, and jug from obs_0060\"}"}}]},"9bc2a75438a6c9c606aaaf24017cb29426ddd4d08b52f8b05728eefee4386e77":{"role":"user","conten