 pose_x + x_cam * math.cos(rad) + z_cam * math.sin(rad)\\n    world_y = pose_y - x_cam * math.sin(rad) + z_cam * math.cos(rad)\\n    return world_x, world_y, z_cam, x_cam\\n\\nprint(\\\"--- 1. FLOOR LAMP ---\\\")\\nfor fid, u, v, px, py, h in [\\n    (6, 359.2, 321.6, 0.0, 0.5, 0.0),\\n    (8, 72.4, 340.9, 0.183, 1.183, 60.0),\\n    (10, 357.5, 338.9, 0.683, 1.683, 0.0),\\n    (15, 213.5, 342.4, 0.933, 2.116, 30.0),\\n]:\\n    wx, wy, zc, xc = floor_point_to_world(u, v, px, py, h)\\n    print(f\\\"Obs {fid:2d}: wx={wx:6.3f}, wy={wy:6.3f} (z_cam={zc:5.2f}, x_cam={xc:5.2f})\\\")\\n\\nprint(\\\"\\\\n--- 2. CHAIR ---\\\")\\n# Obs 2: heading 90, chair front legs at v=425, back legs at v=393, u between 80 and 145\\n# Obs 9: heading 90, chair front legs at v=495, back legs at v=436, u between 195 and 280\\nfor fid, u, v, px, py, h in [\\n    (2, 110.0, 425.0, 0.0, 0.0, 90.0), # front center\\n    (2, 140.0, 393.0, 0.0, 0.0, 90.0), # back center\\n    (9, 238.0, 495.0, 0.683, 1.183, 90.0),\\n    (9, 238.0, 436.0, 0.683, 1.183, 90.0),\\n]:\\n    wx, wy, zc, xc = floor_point_to_world(u, v, px, py, h)\\n    print(f\\\"Obs {fid:2d} (u={u}, v={v}): wx={wx:6.3f}, wy={wy:6.3f} (z_cam={zc:5.2f})\\\")\\n\\nprint(\\\"\\\\n--- 3. POTTED PLANT ---\\\")\\nfor fid, u, v, px, py, h in [\\n    (1, 465.0, 367.0, 0.0, 0.0, 0.0),\\n    (15, 355.5, 436.0, 0.933, 2.116, 30.0),\\n]:\\n    wx, wy, zc, xc = floor_point_to_world(u, v, px, py, h)\\n    print(f\\\"Obs {fid:2d}: wx={wx:6.3f}, wy={wy:6.3f}\\\")\\n\\nprint(\\\"\\\\n--- 4. TABLE ---\\\")\\n# In obs 7 (px=-0.25, py=0.933, h=330):\\n# left front leg: u=311, v=347\\n# left back leg: u=320, v=337\\n# right front leg: u=396, v=363\\n# right back leg: u=396, v=337 (approx)\\nfor name, u, v in [\\n    (\\\"left-front\\\", 311, 347),\\n    (\\\"left-back\\\", 320, 337),\\n    (\\\"right-front\\\", 396, 363),\\n    (\\\"right-back\\\", 396, 337)\\n]:\\n    wx, wy, zc, xc = floor_point_to_world(u, v, -0.25, 0.933, 330.0)\\n    print(f\\\"Table leg